<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    图标全部用矢量路径绘制（24×24 网格），不依赖任何图标字体，
    因此在没有 Segoe MDL2 的机器上也能正常显示。
    路径只使用 M / L / H / V / C / Q / Z，避免弧线命令在不同渲染器上的歧义。
  -->

  <!-- 选择 / 箭头光标 -->
  <StreamGeometry x:Key="IconSelect">M 5.4,1.8 L 18.8,12.6 L 12.4,13.2 L 15.6,20.6 L 12.9,21.8 L 9.8,14.4 L 5.4,19.8 Z</StreamGeometry>

  <!-- 硬笔（钢笔尖，与运行时工具栏图标的定义保持一致） -->
  <StreamGeometry x:Key="IconPen">M 12,1.6 L 18.9,11.9 L 12,16.4 L 5.1,11.9 Z M 12,3.6 L 7.3,11.6 L 12,14.5 L 16.7,11.6 Z M 11.4,17 L 12.6,17 L 12,22.4 Z</StreamGeometry>

  <!-- 荧光笔 -->
  <StreamGeometry x:Key="IconHighlighter">M 3.4,19.2 L 8.4,21.6 L 8.4,23 H 3.4 Z M 9.8,12.6 L 13.6,14.5 L 19.6,8.5 L 15.8,6.6 Z M 16.6,4 L 21,6.2 L 20.4,7.4 L 16,5.2 Z</StreamGeometry>

  <!-- 激光笔（光点 + 光晕） -->
  <StreamGeometry x:Key="IconLaser">M 12,6.4 C 15.1,6.4 17.6,8.9 17.6,12 C 17.6,15.1 15.1,17.6 12,17.6 C 8.9,17.6 6.4,15.1 6.4,12 C 6.4,8.9 8.9,6.4 12,6.4 Z M 12,9.6 C 10.7,9.6 9.6,10.7 9.6,12 C 9.6,13.3 10.7,14.4 12,14.4 C 13.3,14.4 14.4,13.3 14.4,12 C 14.4,10.7 13.3,9.6 12,9.6 Z M 10.9,1.4 H 13.1 V 4.6 H 10.9 Z M 10.9,19.4 H 13.1 V 22.6 H 10.9 Z M 1.4,10.9 H 4.6 V 13.1 H 1.4 Z M 19.4,10.9 H 22.6 V 13.1 H 19.4 Z</StreamGeometry>

  <!-- 橡皮擦（ui/clean.png 的样式：圆角方框 + 两条竖杠） -->
  <StreamGeometry x:Key="IconEraser">M 4,3 H 20 A 2,2 0 0 1 22,5 V 19 A 2,2 0 0 1 20,21 H 4 A 2,2 0 0 1 2,19 V 5 A 2,2 0 0 1 4,3 Z M 9.4,7.4 H 10.6 V 16.6 H 9.4 Z M 13.4,7.4 H 14.6 V 16.6 H 13.4 Z</StreamGeometry>

  <!-- 直线 -->
  <StreamGeometry x:Key="IconLine">M 4.2,16.6 C 5.5,16.6 6.5,17.6 6.5,18.9 C 6.5,20.2 5.5,21.2 4.2,21.2 C 2.9,21.2 1.9,20.2 1.9,18.9 C 1.9,17.6 2.9,16.6 4.2,16.6 Z M 19.8,2.8 C 21.1,2.8 22.1,3.8 22.1,5.1 C 22.1,6.4 21.1,7.4 19.8,7.4 C 18.5,7.4 17.5,6.4 17.5,5.1 C 17.5,3.8 18.5,2.8 19.8,2.8 Z M 6.2,17.5 L 20.2,5.3 L 19,3.8 L 4.4,16.6 Z</StreamGeometry>

  <!-- 箭头（双向） -->
  <StreamGeometry x:Key="IconArrow">M 2.2,19.6 L 12.6,9.2 L 9.8,6.4 L 21.4,2.8 L 17.8,14.4 L 15,11.6 L 4.6,22 Z</StreamGeometry>

  <!-- 矩形 -->
  <StreamGeometry x:Key="IconRectangle">M 2.2,4.4 H 21.8 V 19.6 H 2.2 Z M 4.6,6.8 V 17.2 H 19.4 V 6.8 Z</StreamGeometry>

  <!-- 椭圆 -->
  <StreamGeometry x:Key="IconEllipse">M 2.2,6 H 21.8 V 18 H 2.2 Z M 4.6,8.4 V 15.6 H 19.4 V 8.4 Z</StreamGeometry>

  <!-- 文本（大号字母 T） -->
  <StreamGeometry x:Key="IconText">M 3,3.2 H 21 V 7.2 H 13.4 V 20.8 H 10.6 V 7.2 H 3 Z</StreamGeometry>

  <!-- 撤销（左向弯箭头） -->
  <StreamGeometry x:Key="IconUndo">M 11.6,4.4 V 8.4 C 9.3,8.4 7.4,9.7 7.4,12.1 C 7.4,14.5 9.5,15.9 12,15.9 C 14.5,15.9 16.4,14.4 16.4,12.1 H 19.6 C 19.6,16.2 16.3,18.7 12,18.7 C 7.7,18.7 4.2,16.3 4.2,12.2 C 4.2,8 7.6,4.4 11.6,4.4 Z M 12.4,2 L 8.4,6.4 L 12.4,10.8 Z M 11.6,4.4 C 8.9,4.7 6.9,6.3 5.8,8.3 L 3.1,6.7 C 4.7,4.2 7.6,2.4 10.9,2.1 Z</StreamGeometry>

  <!-- 重做（右向弯箭头） -->
  <StreamGeometry x:Key="IconRedo">M 12.4,4.4 V 8.4 C 14.7,8.4 16.6,9.7 16.6,12.1 C 16.6,14.5 14.5,15.9 12,15.9 C 9.5,15.9 7.6,14.4 7.6,12.1 H 4.4 C 4.4,16.2 7.7,18.7 12,18.7 C 16.3,18.7 19.8,16.3 19.8,12.2 C 19.8,8 16.4,4.4 12.4,4.4 Z M 11.6,2 L 15.6,6.4 L 11.6,10.8 Z M 12.4,4.4 C 15.1,4.7 17.1,6.3 18.2,8.3 L 20.9,6.7 C 19.3,4.2 16.4,2.4 13.1,2.1 Z</StreamGeometry>

  <!-- 清空（垃圾桶） -->
  <StreamGeometry x:Key="IconTrash">M 9.4,2.2 H 14.6 L 15.6,4.6 H 20.8 V 7 H 3.2 V 4.6 H 8.4 Z M 4.6,8.4 H 19.4 V 20.4 C 19.4,21.6 18.4,22.6 17.2,22.6 H 6.8 C 5.6,22.6 4.6,21.6 4.6,20.4 Z M 9.2,10.8 V 20 H 11 V 10.8 Z M 13,10.8 V 20 H 14.8 V 10.8 Z</StreamGeometry>

  <!-- 新增页 -->
  <StreamGeometry x:Key="IconAddPage">M 4,1.8 H 13.6 L 20,8.2 V 22.4 H 4 Z M 12.8,3.8 V 9 H 18 Z M 10.8,12 H 13.2 V 15 H 16.2 V 17.4 H 13.2 V 20.4 H 10.8 V 17.4 H 7.8 V 15 H 10.8 Z</StreamGeometry>

  <!-- 复制 / 多页 -->
  <StreamGeometry x:Key="IconPages">M 2,3.2 H 14.8 V 21.2 H 2 Z M 4.4,5.6 V 18.8 H 12.4 V 5.6 Z M 9.2,0.8 H 22 V 18.4 H 19.6 V 3.2 H 9.2 Z</StreamGeometry>

  <!-- 桌面批注：笔 + 光标 -->
  <StreamGeometry x:Key="IconDesktopPen">M 6.2,9.2 L 15.3,18.3 L 20,23 L 21.6,21.4 L 16.9,16.7 L 7.8,7.6 Z M 5,10.4 L 7.8,7.6 L 4.4,4.2 C 3.9,3.7 3.1,3.7 2.6,4.2 L 2.6,4.2 C 2.1,4.7 2.1,5.5 2.6,6 Z</StreamGeometry>

  <!-- 截屏 / 冻结画面（四角框） -->
  <StreamGeometry x:Key="IconFreeze">M 1.6,3.6 H 10 V 6.2 H 4.2 V 12 H 1.6 Z M 22.4,3.6 V 12 H 19.8 V 6.2 H 14 V 3.6 Z M 1.6,20.4 V 12 H 4.2 V 17.8 H 10 V 20.4 Z M 14,20.4 V 17.8 H 19.8 V 12 H 22.4 V 20.4 Z M 7.8,7.8 H 16.2 V 16.2 H 7.8 Z M 10.2,10.2 V 13.8 H 13.8 V 10.2 Z</StreamGeometry>

  <!-- 缩放适应 -->
  <StreamGeometry x:Key="IconFit">M 2,2.4 H 9.4 V 5 H 4.6 V 9.8 H 2 Z M 14.6,2.4 H 22 V 9.8 H 19.4 V 5 H 14.6 Z M 2,14.2 H 4.6 V 19 H 9.4 V 21.6 H 2 Z M 19.4,14.2 H 22 V 21.6 H 14.6 V 19 H 19.4 Z M 8.4,10.6 H 15.6 V 13.4 H 8.4 Z</StreamGeometry>

  <!-- 全屏（四角） -->
  <StreamGeometry x:Key="IconFullScreen">M 1.6,1.6 H 9 V 4.4 H 4.4 V 9 H 1.6 Z M 15,1.6 H 22.4 V 9 H 19.6 V 4.4 H 15 Z M 1.6,15 H 4.4 V 19.6 H 9 V 22.4 H 1.6 Z M 19.6,15 H 22.4 V 22.4 H 15 V 19.6 H 19.6 Z</StreamGeometry>

  <!-- 打开文件（文件夹） -->
  <StreamGeometry x:Key="IconOpen">M 1.4,3.4 H 8.8 L 10.8,6 H 22.6 V 20.6 H 1.4 Z M 3.8,8.4 V 18.2 H 20.2 V 8.4 Z</StreamGeometry>

  <!-- 保存 -->
  <StreamGeometry x:Key="IconSave">M 2.6,2.6 H 16.4 L 21.4,7.6 V 21.4 H 2.6 Z M 6,2.6 H 14 V 8.6 H 6 Z M 5.6,13 H 18.4 V 20.6 H 5.6 Z</StreamGeometry>

  <!-- 图片 -->
  <StreamGeometry x:Key="IconImage">M 2,3.4 H 22 V 20.6 H 2 Z M 4.4,5.8 V 16.4 L 9,11 L 12.6,14.6 L 16,11 L 19.6,16.2 V 5.8 Z</StreamGeometry>

  <!-- 背景样式：方格 -->
  <StreamGeometry x:Key="IconGrid">M 2.4,2.4 H 21.6 V 21.6 H 2.4 Z M 5.4,5.4 V 18.6 H 18.6 V 5.4 Z M 9.6,5.4 V 18.6 H 14.4 V 5.4 Z M 5.4,9.6 H 18.6 V 14.4 H 5.4 Z</StreamGeometry>

  <!-- 调色板 -->
  <StreamGeometry x:Key="IconPalette">M 12,2 C 17.5,2 22,6.5 22,12 C 22,14 20.5,15.4 18.6,15.4 H 16.4 C 15.2,15.4 14.4,16.3 14.4,17.4 C 14.4,17.9 14.6,18.4 14.9,18.8 C 15.4,19.4 15.7,20.1 15.7,20.9 C 15.7,21.5 15.4,22 12,22 C 6.5,22 2,17.5 2,12 C 2,6.5 6.5,2 12,2 Z M 12,4.4 C 7.8,4.4 4.4,7.8 4.4,12 C 4.4,16.2 7.8,19.6 12,19.6 C 12.6,19.6 13.1,19.5 13.4,19.4 C 13.1,18.8 13,18.2 13,17.4 C 13,15 14.4,13 16.4,13 H 18.6 C 19.6,13 19.6,12.4 19.6,12 C 19.6,7.8 16.2,4.4 12,4.4 Z M 7.4,7.4 C 8.4,7.4 9.2,8.2 9.2,9.2 C 9.2,10.2 8.4,11 7.4,11 C 6.4,11 5.6,10.2 5.6,9.2 C 5.6,8.2 6.4,7.4 7.4,7.4 Z M 16.6,7.4 C 17.6,7.4 18.4,8.2 18.4,9.2 C 18.4,10.2 17.6,11 16.6,11 C 15.6,11 14.8,10.2 14.8,9.2 C 14.8,8.2 15.6,7.4 16.6,7.4 Z M 12,12.4 C 13,12.4 13.8,13.2 13.8,14.2 C 13.8,15.2 13,16 12,16 C 11,16 10.2,15.2 10.2,14.2 C 10.2,13.2 11,12.4 12,12.4 Z</StreamGeometry>

  <!-- 上一页 / 下一页 -->
  <StreamGeometry x:Key="IconChevronLeft">M 15.6,3.4 L 18,5.8 L 10.6,13.2 L 18,20.6 L 15.6,23 L 5.8,13.2 Z</StreamGeometry>
  <StreamGeometry x:Key="IconChevronRight">M 8.4,3.4 L 6,5.8 L 13.4,13.2 L 6,20.6 L 8.4,23 L 18.2,13.2 Z</StreamGeometry>

  <!-- 关闭 -->
