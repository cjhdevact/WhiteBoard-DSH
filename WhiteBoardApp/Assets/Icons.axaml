  <!-- 退出批注（门 + 箭头） -->
  <StreamGeometry x:Key="IconExit">M 10.4,2.8 H 3.6 V 21.2 H 10.4 V 18.6 H 6.2 V 5.4 H 10.4 Z M 14.4,6.6 L 19.4,11.6 L 14.4,16.6 L 12.7,14.9 L 14.6,13 H 8.6 V 10.2 H 14.6 L 12.7,8.3 Z</StreamGeometry>

  <!-- 鼠标穿透（光标 + 箭头） -->
  <StreamGeometry x:Key="IconClickThrough">M 6.4,1.6 L 17.6,12.8 H 11.6 L 14.8,20.4 L 12.2,21.5 L 9,13.9 L 6.4,16.9 Z</StreamGeometry>

  <!-- 光标 -->
