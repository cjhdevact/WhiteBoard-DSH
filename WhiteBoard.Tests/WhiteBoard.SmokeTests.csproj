<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WhiteBoard.SmokeTests</AssemblyName>
    <RootNamespace>WhiteBoard.SmokeTests</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AvaloniaTelemetryOptOut>true</AvaloniaTelemetryOptOut>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WhiteBoardApp\WhiteBoard.csproj" />
  </ItemGroup>

</Project>
