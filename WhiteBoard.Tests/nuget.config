<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    离线还原配置：
    本机可访问的 NuGet 私有/本地缓存被登记为唯一包源，避免联网失败导致的还原错误。
    如需联网还原，请把下面的 clear 节点删除，或改用 nuget.org。
  -->
  <packageSources>
    <clear />
    <add key="local-cache" value="%USERPROFILE%\.nuget\packages" />
    <add key="vs-offline" value="C:\Program Files (x86)\Microsoft SDKs\NuGetPackages" />
  </packageSources>
  <config>
    <add key="globalPackagesFolder" value="%USERPROFILE%\.nuget\packages" />
  </config>
</configuration>
