<?xml version="1.0" encoding="utf-8"?>
<!--
  离线还原配置。
  本机 NuGet 缓存（%USERPROFILE%\.nuget\packages）被登记为唯一包源，
  这样在没有外网的环境里也能还原 Avalonia 11.3.12 等依赖。
  如需联网还原，删除下面的 <clear /> 并恢复 nuget.org 即可。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-cache" value="%USERPROFILE%\.nuget\packages" />
    <add key="vs-offline" value="C:\Program Files (x86)\Microsoft SDKs\NuGetPackages" />
  </packageSources>
  <config>
    <add key="globalPackagesFolder" value="%USERPROFILE%\.nuget\packages" />
  </config>
</configuration>
